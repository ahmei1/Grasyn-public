generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens      RefreshToken[]
  memberships        WorkspaceMember[]
  ownedWorkspaces    Workspace[]          @relation("WorkspaceOwner")
  assignedTasks      Task[]               @relation("TaskAssignee")
  createdTasks       Task[]               @relation("TaskCreator")
  comments           Comment[]
  notifications      Notification[]
  activity           ActivityEvent[]
  projectMemberships ProjectMember[]
  messages           Message[]
  createdMeetings    Meeting[]            @relation("MeetingCreator")
  meetingSeats       MeetingParticipant[]
  meetingActions     MeetingActionItem[]  @relation("ActionAssignee")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  /// Short code in task keys, such as "GS" in GS-42. Developers type the key
  /// in branch names and commit messages to link code to a task.
  taskPrefix  String   @default("GS")
  /// Last task number handed out. Incremented inside the task insert.
  taskCounter Int      @default(0)
  ownerId     String
  owner       User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       WorkspaceMember[]
  invites       WorkspaceInvite[]
  projects      Project[]
  activity      ActivityEvent[]
  notifications Notification[]
  auditEvents   AuditEvent[]
  messages      Message[]
  meetings      Meeting[]
  github        GitHubInstallation?
  repositories  Repository[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  expiresAt   DateTime
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, email])
}

model Project {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  description String          @default("")
  status      ProjectStatus   @default(ACTIVE)
  priority    ProjectPriority @default(MEDIUM)
  ownerId     String
  startDate   DateTime?
  dueDate     DateTime?
  archivedAt  DateTime?
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  tasks       Task[]
  activity    ActivityEvent[]
  messages    Message[]
  meetings    Meeting[]
  repos       Repository[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([workspaceId, status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Task {
  id          String             @id @default(cuid())
  workspaceId String
  projectId   String
  /// Per-workspace number; with the workspace prefix it forms the task key.
  number      Int
  title       String
  description String             @default("")
  status      TaskStatus         @default(TODO)
  priority    TaskPriority       @default(MEDIUM)
  assigneeId  String?
  creatorId   String
  dueDate     DateTime?
  position    Int                @default(0)
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?              @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator     User               @relation("TaskCreator", fields: [creatorId], references: [id])
  comments    Comment[]
  activity    ActivityEvent[]
  messages    Message[]
  fromAction  MeetingActionItem?
  commits     CommitTask[]
  pulls       PullRequestTask[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([workspaceId, number])
  @@index([workspaceId, assigneeId])
  @@index([projectId, status, position])
}

model Comment {
  id          String   @id @default(cuid())
  workspaceId String
  taskId      String
  authorId    String
  body        String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId, createdAt])
}

/// One message shape for every conversation: project discussion today,
/// task or workspace threads later. Edited messages keep their original time.
model Message {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String?
  taskId      String?
  authorId    String
  body        String
  editedAt    DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([projectId, createdAt])
  @@index([workspaceId, createdAt])
}

model Meeting {
  id           String               @id @default(cuid())
  workspaceId  String
  projectId    String?
  title        String
  startsAt     DateTime
  endsAt       DateTime?
  notes        String               @default("")
  createdById  String
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("MeetingCreator", fields: [createdById], references: [id])
  participants MeetingParticipant[]
  decisions    MeetingDecision[]
  actionItems  MeetingActionItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([projectId, startsAt])
  @@index([workspaceId, startsAt])
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([meetingId, userId])
}

model MeetingDecision {
  id        String   @id @default(cuid())
  meetingId String
  body      String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([meetingId, createdAt])
}

/// An agreed follow-up. Once turned into a task it keeps the link, so the
/// task can always be traced back to the meeting that produced it.
model MeetingActionItem {
  id         String    @id @default(cuid())
  meetingId  String
  title      String
  assigneeId String?
  dueDate    DateTime?
  taskId     String?   @unique
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee   User?     @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([meetingId, createdAt])
}

/// The GitHub App installation that feeds a workspace. One each way: a
/// workspace has at most one installation, and an installation one workspace.
model GitHubInstallation {
  id             String       @id @default(cuid())
  workspaceId    String       @unique
  installationId BigInt       @unique
  accountLogin   String
  accountType    String
  connectedById  String
  suspendedAt    DateTime?
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositories   Repository[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

/// A repository the installation can see. Mapping it to a project puts its
/// code on that project's Code tab; task keys link code regardless.
model Repository {
  id             String             @id @default(cuid())
  workspaceId    String
  installationId String
  githubId       BigInt             @unique
  fullName       String
  htmlUrl        String
  defaultBranch  String             @default("main")
  private        Boolean            @default(true)
  projectId      String?
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation   GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  project        Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  commits        Commit[]
  pullRequests   PullRequest[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([workspaceId])
  @@index([projectId])
}

/// Stored once per repository, on the first branch it was pushed to.
model Commit {
  id           String       @id @default(cuid())
  repositoryId String
  sha          String
  message      String
  url          String
  branch       String
  authorName   String
  authorLogin  String?
  committedAt  DateTime
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  tasks        CommitTask[]
  createdAt    DateTime     @default(now())

  @@unique([repositoryId, sha])
  @@index([repositoryId, committedAt])
}

model CommitTask {
  commitId String
  taskId   String
  commit   Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([commitId, taskId])
  @@index([taskId])
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

model PullRequest {
  id           String            @id @default(cuid())
  repositoryId String
  number       Int
  title        String
  url          String
  state        PullRequestState  @default(OPEN)
  draft        Boolean           @default(false)
  authorLogin  String
  headBranch   String
  baseBranch   String
  /// Latest APPROVED or CHANGES_REQUESTED review; plain comments don't count.
  reviewState  String?
  openedAt     DateTime
  mergedAt     DateTime?
  closedAt     DateTime?
  repository   Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  tasks        PullRequestTask[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([repositoryId, number])
  @@index([repositoryId, updatedAt])
}

model PullRequestTask {
  pullRequestId String
  taskId        String
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([pullRequestId, taskId])
  @@index([taskId])
}

/// GitHub retries deliveries; the delivery id makes each one count once.
model GitHubDelivery {
  id         String   @id
  event      String
  receivedAt DateTime @default(now())
}

/// Activity from GitHub has no Grasyn actor; the GitHub login is in metadata.
model ActivityEvent {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String?
  taskId      String?
  actorId     String?
  type        String
  metadata    Json      @default("{}")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
}

model Notification {
  id           String    @id @default(cuid())
  workspaceId  String
  userId       String
  type         String
  title        String
  body         String
  readAt       DateTime?
  resourceType String?
  resourceId   String?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([userId, workspaceId, createdAt])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String
  action      String
  metadata    Json      @default("{}")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}
